# Supabase — required
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ML Model (local, no API key needed — model is auto-downloaded from HuggingFace on first run)
ML_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# Redis — for rate limiting
REDIS_URL=redis://localhost:6379

# JWT secret for share tokens (generate a random 64-char string)
JWT_SECRET=change-me-to-a-random-64-char-string

# Environment
ENVIRONMENT=dev

# Limits
MAX_PDF_SIZE_MB=5

# CORS (comma-separated frontend URLs)
ALLOWED_ORIGINS=http://localhost:3000,https://your-app.vercel.app
